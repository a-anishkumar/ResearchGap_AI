# Backend Environment Variables
# Copy this to .env and fill in real values

# Google Gemini API key (required for LLM extraction + gap suggestions)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Neo4j AuraDB connection
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# Local paths (relative to backend/ directory)
VECTOR_DB_PATH=./data/chroma
DATA_RAW_PATH=./data/raw

# Model settings
LLM_MODEL=gemini-3.1-flash-lite
EMBEDDING_MODEL=all-MiniLM-L6-v2
TOP_GAPS=20
RAG_TOP_K=5
MAX_UPLOAD_MB=50

# Ollama (Optional Local Processing)
# Set USE_OLLAMA=true to run local extraction first, reducing Gemini token costs
USE_OLLAMA=false
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
